          "assignments": [
            {
              "id": "8119f7d7-394a-47bb-95eb-487feeb6da97",
              "name": "appUrl",
              "value": "http://app:3000",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7df4fac9-c428-441f-8c97-4427a430d39c",
