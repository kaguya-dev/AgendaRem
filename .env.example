# npm run setup cria .env com segredos aleatórios. Não publique esse arquivo.
APP_URL=http://localhost:3000
PANEL_PASSWORD=
SESSION_SECRET=
INTERNAL_API_TOKEN=
# Local: PostgreSQL embutido em .data. Produção: postgres + URL do Neon (SSL).
DATABASE_MODE=local
DATABASE_URL=
LOCAL_DATABASE_PATH=.data/agenda

# none: comandos básicos sem IA. gemini ou compatible: API configurável.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Apenas para compatible: URL completa de chat/completions de seu provedor.
LLM_API_URL=
LLM_DAILY_LIMIT=100

WAHA_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_SESSION=default
# Identificador exato da conversa autorizada, obtido no evento WAHA.
WHATSAPP_ALLOWED_CHAT_ID=

# Opcional: acelera processamento; a rotina do n8n recupera a fila a cada minuto.
N8N_PROCESS_WEBHOOK_URL=http://localhost:5678/webhook/agendamagno-processar
N8N_WEBHOOK_TOKEN=
N8N_ENCRYPTION_KEY=
# Defina uma versão concreta da imagem WAHA antes de iniciar o perfil whatsapp.
WAHA_IMAGE=
